{
  "name": "lms3/lms3h5p",
  "description": "H5P Platform Integration Plugin for TYPO3 CMS",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0+",
  "authors": [
    {
      "name": "Sagar Desai",
      "email": "sagardesai1990@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-zip": "*",
    "h5p/h5p-core": "1.28.0",
    "h5p/h5p-editor": "1.25",
    "typo3/cms-core": "^12 || ^13",
    "typo3/cms-backend": "^12 || ^13",
    "typo3/cms-extbase": "^12 || ^13",
    "guzzlehttp/guzzle": "*"
  },
  "autoload": {
